// Custom zjstatus top bar (nord). Loaded because config.kdl sets
// default_layout "default". Plugin binary: ../plugins/zjstatus.wasm
// zjstatus format tokens: {session} {tabs} {mode}; #[fg=..,bg=..,bold] style spans.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:/Users/declanelias/dotfiles/zellij/plugins/zjstatus.wasm" {
                format_left  "{session}{tabs}"
                format_right "{mode}"
                format_space "#[bg=default]"

                border_enabled  "false"
                hide_frame_for_single_pane "false"

                // frost-blue session badge, folder icon, then a powerline wedge
                session "#[fg=#81a1c1]#[fg=#2e3440,bg=#81a1c1,bold]  {name} #[fg=#81a1c1,bg=default] "

                // tabs: active = nord8 rounded pill, inactive = muted grey text
                tab_normal "#[fg=#4c566a,bg=default] {index}  {name} "
                tab_active "#[fg=#88c0d0,bg=default]#[fg=#2e3440,bg=#88c0d0,bold] {index}  {name} #[fg=#88c0d0,bg=default]"

                // mode indicator (right); color per zellij mode
                mode_normal       "#[fg=#a3be8c]#[fg=#2e3440,bg=#a3be8c,bold] NORMAL #[bg=default]"
                mode_locked       "#[fg=#4c566a]#[fg=#eceff4,bg=#4c566a,bold] LOCKED #[bg=default]"
                mode_pane         "#[fg=#81a1c1]#[fg=#2e3440,bg=#81a1c1,bold] PANE #[bg=default]"
                mode_tab          "#[fg=#88c0d0]#[fg=#2e3440,bg=#88c0d0,bold] TAB #[bg=default]"
                mode_resize       "#[fg=#d08770]#[fg=#2e3440,bg=#d08770,bold] RESIZE #[bg=default]"
                mode_move         "#[fg=#d08770]#[fg=#2e3440,bg=#d08770,bold] MOVE #[bg=default]"
                mode_scroll       "#[fg=#ebcb8b]#[fg=#2e3440,bg=#ebcb8b,bold] SCROLL #[bg=default]"
                mode_search       "#[fg=#ebcb8b]#[fg=#2e3440,bg=#ebcb8b,bold] SEARCH #[bg=default]"
                mode_enter_search "#[fg=#ebcb8b]#[fg=#2e3440,bg=#ebcb8b,bold] SEARCH #[bg=default]"
                mode_session      "#[fg=#b48ead]#[fg=#2e3440,bg=#b48ead,bold] SESSION #[bg=default]"
                mode_tmux         "#[fg=#d08770]#[fg=#2e3440,bg=#d08770,bold] TMUX #[bg=default]"
                mode_rename_tab   "#[fg=#ebcb8b]#[fg=#2e3440,bg=#ebcb8b,bold] RENAME #[bg=default]"
                mode_rename_pane  "#[fg=#ebcb8b]#[fg=#2e3440,bg=#ebcb8b,bold] RENAME #[bg=default]"
            }
        }
        children
    }
}
